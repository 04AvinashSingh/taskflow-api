# ═══════════════════════════════════════════
# TaskFlow API — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow?schema=public

# JWT secret — use a strong random string (64+ chars)
JWT_SECRET=change_me_to_a_very_long_random_secret_string_at_least_64_characters

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
