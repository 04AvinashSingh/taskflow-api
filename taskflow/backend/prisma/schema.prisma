// ═══════════════════════════════════════════
// Prisma Schema — TaskFlow API
// ═══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  IN_PROGRESS
  DONE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  tasks     Task[]

  @@map("users")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      Status   @default(PENDING)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("tasks")
}
